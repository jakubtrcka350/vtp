# ── Admin authentication ──────────────────────────────────────────────────────
# Password for the /sprava admin login page
ADMIN_PASSWORD=your-strong-password-here

# Random secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your-64-char-hex-secret-here

# ── Vercel KV (Redis) ─────────────────────────────────────────────────────────
# Added automatically when you connect a KV store in the Vercel dashboard:
#   Dashboard → Storage → Create Database → KV → Connect to project
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Resend (transactional email) ─────────────────────────────────────────────
# API key from resend.com dashboard
RESEND_API_KEY=re_your-api-key-here

# Email address where owner notifications are delivered
OWNER_EMAIL=vodo-topo-trcka@seznam.cz

# Verified sender address (must match a domain verified in Resend)
# e.g. "VTP Trčka <noreply@vtptrcka.cz>"
FROM_EMAIL=VTP Trčka <noreply@vtptrcka.cz>

# ── Vercel Blob ───────────────────────────────────────────────────────────────
# Added automatically when you connect a Blob store in the Vercel dashboard:
#   Dashboard → Storage → Create Database → Blob → Connect to project
BLOB_READ_WRITE_TOKEN=
