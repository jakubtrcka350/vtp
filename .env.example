# Admin Authentication
# Password for the /sprava admin panel
ADMIN_PASSWORD=your-secure-password-here

# Secret for signing admin session tokens (random string, min 32 chars)
ADMIN_SECRET=your-random-secret-string-min-32-chars

# Vercel KV (auto-populated by Vercel when you add a KV store)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Vercel Blob (auto-populated by Vercel when you add Blob storage)
BLOB_READ_WRITE_TOKEN=
